# Copy these into Hostinger > Node.js Web App > Environment Variables.
# Obtain DATABASE_URL from your external PostgreSQL provider (use its session pooler URI).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Generate a unique random value with at least 32 characters.
SESSION_SECRET=replace_with_a_unique_random_secret_of_48_or_more_characters
NODE_ENV=production
# Hostinger normally injects PORT automatically. Do not set it manually unless instructed by Hostinger.
